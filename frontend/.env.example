# Port Vite dev server runs on
VITE_PORT=5173

# Backend API Base URL
# Use http://localhost:5000/api for local testing
# Or replace localhost with your machine's LAN IP (e.g. http://192.168.0.115:5000/api) for demo to guide
VITE_API_BASE_URL=http://localhost:5000/api

# Static Uploads Base URL
VITE_UPLOADS_BASE_URL=http://localhost:5000/uploads
